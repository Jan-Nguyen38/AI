# Copy to .env and fill in ONE of the two options. Never commit .env.

# Option A: free open model through Hugging Face (needs a free account)
LLM_PROVIDER=huggingface
HF_TOKEN=
HF_MODEL=auto
# auto tries well-known models until one works. To pin one, run: python -m rag.hf_models

# Option B: Claude (needs an API key from platform.claude.com, not a Claude.ai subscription)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low

# Optional retrieval settings
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# EMBED_BACKEND=fastembed        # or "hash" (offline, keyword-only, for testing)
# DATA_DIR=./data
# TOP_K=5
# MIN_SCORE=0.45

# Logging: INFO shows each question, retrieval summary, model used and timing.
# DEBUG adds every passage score, the full prompt and the answer. Secrets are never logged.
# LOG_LEVEL=INFO
