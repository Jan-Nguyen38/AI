# Copy to .env and fill in ONE of the two options. Never commit .env.

# Option A: free open model through Hugging Face (needs a free account)
LLM_PROVIDER=huggingface
HF_TOKEN=
# HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# Option B: Claude (needs an API key from platform.claude.com, not a Claude.ai subscription)
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low

# Optional retrieval settings
# EMBED_MODEL=BAAI/bge-small-en-v1.5
# EMBED_BACKEND=fastembed        # or "hash" (offline, keyword-only, for testing)
# DATA_DIR=./data
# TOP_K=5
# MIN_SCORE=0.45
